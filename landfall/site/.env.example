# =====================================================================
# Landfall backend configuration. Copy to .env.local and fill in.
# Never commit .env.local. Variables prefixed NEXT_PUBLIC_ are sent to
# the browser; everything else stays on the server.
# =====================================================================

# ---- App ----
# Absolute origin, used for links in emails and auth redirects.
APP_URL=http://localhost:3003

# ---- Supabase (Project Settings > API Keys / Data API) ----
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy "service_role" key. SERVER ONLY.
SUPABASE_SECRET_KEY=
# Postgres connection string (Connect > Session pooler). Only used by
# `npm run db:push` to apply migrations; the app never reads it.
SUPABASE_DB_URL=

# ---- Duffel (dashboard > Developers > Access tokens) ----
# Test token starts with duffel_test_. Leave empty to run the simulated
# supplier (the demo catalogue) instead of Duffel.
DUFFEL_ACCESS_TOKEN=
# From POST /air/webhooks (shown once). Optional in local development.
DUFFEL_WEBHOOK_SECRET=
# Optional override: duffel | simulated. Default: duffel when a token is set.
SUPPLY_MODE=

# ---- Stripe (dashboard > Developers > API keys, test mode) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=

# ---- Email (any SMTP provider: Resend, Postmark, SES...) ----
# Leave SMTP_HOST empty in development: emails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Landfall <bookings@example.com>"
# Where contact-form messages are delivered.
SUPPORT_EMAIL=

# ---- Security ----
# 32 random bytes, base64. Encrypts passenger documents between checkout
# and booking. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Bearer secret for the scheduled job endpoint (/api/cron/reconcile).
CRON_SECRET=

# ---- Pricing (placeholder: no markup until the client decides) ----
APP_CURRENCY=USD
PRICE_MARKUP_PERCENT=0
PRICE_MARKUP_FIXED_CENTS=0
